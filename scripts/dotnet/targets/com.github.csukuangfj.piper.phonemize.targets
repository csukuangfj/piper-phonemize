<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CopyEspeakNgData" AfterTargets="Build">
    <ItemGroup>
      <EspeakNgDataFiles Include="$(MSBuildThisFileDirectory)..\contentFiles\any\any\espeak-ng-data\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EspeakNgDataFiles)"
          DestinationFiles="@(EspeakNgDataFiles->'$(OutputPath)espeak-ng-data\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
